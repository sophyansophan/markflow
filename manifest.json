{
  "id": "./index.html",
  "name": "MarkFlow Studio — Pembaca & Editor Markdown",
  "short_name": "MarkFlow",
  "description": "Aplikasi pembaca dan editor file Markdown (.md, .mdx, .txt, .json, .yaml, .csv, .log) bergaya App Store dengan sistem Auto-Update GitHub PWA.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F2F2F7",
  "theme_color": "#007AFF",
  "categories": ["productivity", "developer tools", "utilities", "education"],
  "lang": "id-ID",
  "dir": "ltr",
  "icons": [
    {
      "src": "./icon192px.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon512px.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon192px",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon512px",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/markdown": [".md", ".markdown", ".mdown", ".mkd", ".mdx"],
        "text/plain": [".txt", ".log", ".ini", ".cfg", ".conf", ".env"],
        "application/json": [".json"],
        "text/yaml": [".yml", ".yaml", ".toml"],
        "text/csv": [".csv", ".tsv"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Buka File Baru",
      "short_name": "Buka File",
      "description": "Buka file Markdown atau teks dari perangkat",
      "url": "./index.html?action=open",
      "icons": [{ "src": "./icon192px.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Catatan Markdown Baru",
      "short_name": "Dokumen Baru",
      "description": "Buat dokumen Markdown baru di editor",
      "url": "./index.html?action=new",
      "icons": [{ "src": "./icon192px.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
